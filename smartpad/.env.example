# SmartPad configuration. Copy to .env (start.bat does this automatically).
# This file stays on the computer; nothing here is ever sent to the phone.

# --- Handwriting recognition ----------------------------------------------------
# Default: everything runs locally on this computer (TrOCR model + offline spelling).
# No key, no internet after the first model download (into ./models).
#   microsoft/trocr-small-handwritten  ~250 MB, fast (~3 s per page)   <- default
#   microsoft/trocr-base-handwritten   ~1.3 GB, ~5x slower, slightly better on messy writing
SMARTPAD_OCR_MODEL=microsoft/trocr-small-handwritten
# 1 = load the model in the background when the server starts
SMARTPAD_OCR_PRELOAD=1

# Optional cloud AI. Leave empty to stay fully local.
ANTHROPIC_API_KEY=
# auto (cloud only if a key is set) | local | anthropic
SMARTPAD_AI_PROVIDER=auto
SMARTPAD_MODEL=claude-opus-5-5

# --- Server --------------------------------------------------------------------
SMARTPAD_PORT=8765
# 1 = HTTPS/WSS with a self-signed certificate (phone shows a one-time warning)
SMARTPAD_HTTPS=0
# Fixed pairing code (leave empty = new random code every start)
SMARTPAD_TOKEN=
# 0 = never move the real mouse (testing)
SMARTPAD_INPUT_CONTROL=1
